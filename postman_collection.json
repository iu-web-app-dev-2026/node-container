{
  "info": {
    "name": "Rides API",
    "_postman_id": "7f8d0f2a-f32a-4d9e-9ec5-c77b8929f401",
    "description": "Postman collection for the rides REST endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Rides",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/rides",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "rides"
          ]
        },
        "description": "Returns all rides."
      },
      "response": []
    },
    {
      "name": "Create Ride",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json && json.ride && json.ride.id) {",
              "    pm.collectionVariables.set('rideId', json.ride.id);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contact\": {\n    \"name\": \"Alice Example\",\n    \"email\": \"alice@example.com\",\n    \"phone\": \"+49123456789\"\n  },\n  \"startDateTime\": \"2026-06-01T08:30:00Z\",\n  \"startTown\": \"Berlin\",\n  \"destinationTown\": \"Hamburg\",\n  \"availableSeats\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/rides",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "rides"
          ]
        },
        "description": "Creates a new ride and stores the created ID as collection variable rideId."
      },
      "response": []
    },
    {
      "name": "Get Ride By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/rides/{{rideId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "rides",
            "{{rideId}}"
          ]
        },
        "description": "Returns a single ride by ID."
      },
      "response": []
    },
    {
      "name": "Update Ride",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contact\": {\n    \"name\": \"Alice Example\",\n    \"email\": \"alice.updated@example.com\",\n    \"phone\": \"+49123456789\"\n  },\n  \"startDateTime\": \"2026-06-01T09:00:00Z\",\n  \"startTown\": \"Berlin\",\n  \"destinationTown\": \"Leipzig\",\n  \"availableSeats\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/rides/{{rideId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "rides",
            "{{rideId}}"
          ]
        },
        "description": "Updates an existing ride by ID."
      },
      "response": []
    },
    {
      "name": "Delete Ride",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/rides/{{rideId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "rides",
            "{{rideId}}"
          ]
        },
        "description": "Deletes a ride by ID."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "rideId",
      "value": "replace-with-ride-id"
    }
  ]
}
