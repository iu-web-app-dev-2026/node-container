{
  "name": "node-static-server",
  "version": "1.0.0",
  "description": "Static HTML server using Node.js",
  "main": "index.js",
  "scripts": {
    "www": "http-server ./www -p 8080 -o",
    "api": "node src/entry-point.js",
    "all": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run www\"",
    "test": "jest src/*.test.js",
    "test:e2e": "jest system-tests/*.test.js"
  },
  "keywords": [
    "static",
    "html",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html-validate": "^11.3.0",
    "http-server": "^14.1.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "selenium-webdriver": "^4.44.0",
    "supertest": "^7.2.2"
  }
}
